!/external_raw/*.sh
*.wav
*.flac
*.mp3
*.mp4
*.m4a
*.zip
*.tar.gz
*.parquet
*.npz
__pycache__/
*.pyc
/data/deliverables/command_classifier/model/ab_kit/ab_results/
!/data/commands_hf_*.csv
